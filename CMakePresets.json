{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror -O3"
      }
    },
    {
      "name": "debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror -O1 -g"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Default optimised build",
      "configurePreset": "default",
      "targets": [
        "passdar"
      ],
      "cleanFirst": false,
      "jobs": 8
    },
    {
      "name": "debug",
      "displayName": "Build with debug flags",
      "configurePreset": "debug",
      "targets": [
        "passdar"
      ],
      "cleanFirst": true,
      "jobs": 8
    }
  ]
}
