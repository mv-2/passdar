{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror"
      }
    },
    {
      "name": "default",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux",
      "inherits": "default",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "windows",
      "inherits": "default",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-release"
      }
    },
    {
      "name": "debug",
      "inherits": "base"
    }
  ],
  "buildPresets": [
    {
      "name": "base-build",
      "targets": [
        "passdar"
      ],
      "jobs": 8,
      "hidden": true
    },
    {
      "name": "default-linux",
      "displayName": "Default optimised build for x64 linux",
      "configurePreset": "linux",
      "cleanFirst": false,
      "inherits": "base-build"
    },
    {
      "name": "release-linux",
      "displayName": "Release build for x64 linux",
      "configurePreset": "linux",
      "cleanFirst": true,
      "inherits": "base-build"
    },
    {
      "name": "default-windows",
      "displayName": "Default optimised build for x64 windows",
      "configurePreset": "windows",
      "cleanFirst": false,
      "inherits": "base-build"
    },
    {
      "name": "release-windows",
      "displayName": "Release build for x64 windows",
      "configurePreset": "windows",
      "cleanFirst": true,
      "inherits": "base-build"
    },
    {
      "name": "debug",
      "displayName": "Build with debug flags",
      "configurePreset": "debug",
      "cleanFirst": false,
      "inherits": "base-build"
    }
  ]
}
